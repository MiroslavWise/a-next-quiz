# Скопируйте в корень проекта как `.env.sync` и подставьте свои значения.
# Файл `.env.sync` в .gitignore — токен не попадёт в репозиторий.

# HTTPS URL репозитория бэкенда (без токена в URL)
SYNC_REPO_URL=https://github.com/ВАШ_ОРГ/ВАШ_БЭКЕНД.git

# Опционально: ветка или тег (по умолчанию main)
SYNC_REPO_REF=main

# Для приватного репозитория: Personal Access Token (read repo)
# GITHUB_TOKEN=ghp_xxxxxxxx

# Пары "путь от корня клонированного репо : путь в этом фронтенде" (через запятую).
# Можно коротко без двоеточия: тогда файл копируется под тем же путём во фронте (например docs/API.md → docs/API.md).
# Пример: один файл
# SYNC_MAP=src/shared/api-types.ts:app/api/backend-types.ts
# Пример: несколько файлов
# SYNC_MAP=src/types/user.ts:app/interface/user-backend.ts,docs/openapi.json:app/api/openapi.json

SYNC_MAP=docs/API.md
